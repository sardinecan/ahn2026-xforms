<?xml version="1.0" encoding="UTF-8"?>
<?xml-stylesheet href="../assets/xsltforms/xsltforms.xsl" type="text/xsl"?>
<!-- 
    EXERCICE 2 : Formulaire liste de notices bibliographiques
    
    OBJECTIFS :
    - Implémenter les répétitions
    - Déclarer une seconde instance pour une liste d’auteurs
    - Mettre en place une liste de choix à partir d’une instance
-->
<html xmlns="http://www.w3.org/1999/xhtml"
    xmlns:xf="http://www.w3.org/2002/xforms"
    xmlns:ev="http://www.w3.org/2001/xml-events"
    xmlns:tei="http://www.tei-c.org/ns/1.0"
    tei:bogus="fix/Firefox/namespace/issue">
    <head>
        <title>AHN 2026 ex02 : Formulaire liste de notices bibliographiques</title>
        <xf:model>
            <!-- 01 Modifier l’instance pour en faire une liste de notices et insérer 2 entrées vides -->
            <xf:instance id="listBibl">
                <listBibl xmlns="http://www.tei-c.org/ns/1.0">
                    <bibl>
                        <author></author>
                        <title></title>
                        <date></date>
                    </bibl>
                    <bibl>
                        <author></author>
                        <title></title>
                        <date></date>
                    </bibl>
                </listBibl>
            </xf:instance>
            <!-- 01b penser à adapter le chemin du bind -->
            <xf:bind nodeset="tei:bibl/tei:date" type="date"/>
            
            <!-- 02 Ajouter une instance contenant une liste d’auteurs (penser à ajouter des ids) -->    
            <xf:instance id="listAuthor">
                <listPerson xmlns="http://www.tei-c.org/ns/1.0">
                    <person id="hugo">
                        <persName>Victor Hugo</persName>
                    </person>
                    <person id="musset">
                        <persName>Alfred de Musset</persName>
                    </person>
                    <person id="zola">
                        <persName>Émile Zola</persName>
                    </person>
                </listPerson>
            </xf:instance>
        </xf:model>
    </head>
    <body>
        <!-- 03 adapter le formulaire pour 
            - la liste de notices
            - sélectionner les auteurs à partir de la seconde instance 
        -->
        <xf:repeat nodeset="tei:bibl">
            <xf:select1 ref="tei:author">
                <xf:label>Auteur : </xf:label>
                <xf:itemset ref="instance('listAuthor')/tei:person">
                    <xf:label ref="tei:persName"/>
                    <xf:value ref="tei:persName"/>
                </xf:itemset>
            </xf:select1>
            <br/>
            <xf:input ref="tei:title"><xf:label>Titre : </xf:label></xf:input>
            <br/>
            <xf:input ref="tei:date"><xf:label>Date : </xf:label></xf:input>
        </xf:repeat>
    </body>
</html>
